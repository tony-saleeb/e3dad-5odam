rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get lowercased email of the current authenticated user
    function currentUserEmail() {
      return request.auth.token.email.lower();
    }

    // Helper: Check if the user document exists in allowed_users collection
    function userExists() {
      return exists(/databases/$(database)/documents/allowed_users/$(currentUserEmail()));
    }

    // Helper: Get user profile details from allowed_users collection
    function getUserData() {
      return get(/databases/$(database)/documents/allowed_users/$(currentUserEmail())).data;
    }

    // Helper: Check if current user is an Admin
    function isAdmin() {
      return isSignedIn() && userExists() && getUserData().role == 'admin';
    }

    // Helper: Check if current user is a Servant
    function isServant() {
      return isSignedIn() && userExists() && getUserData().role == 'servant';
    }

    // Helper: Check if current user is a normal team leader
    function isUser() {
      return isSignedIn() && userExists() && getUserData().role == 'user';
    }

    // Helper: Check if current user is a Church Leader
    function isChurchLeader() {
      return isSignedIn() && userExists() && getUserData().role == 'church_leader';
    }

    // Helper: Check if current user is the Church Leader for a given church name
    function isChurchLeaderFor(church) {
      return isChurchLeader() && getUserData().churchName == church;
    }

    // ==========================================
    // 1. Allowed Users Rules (Allowed emails & roles)
    // ==========================================
    match /allowed_users/{email} {
      // Admins can manage all users
      allow read, write: if isAdmin();
      
      // Read: Any signed-in user can read allowed users (needed to query group counts and select church teams)
      allow read: if isSignedIn();
      
      // Users and church leaders can update their own profile details - blocks self-privilege escalation
      allow update: if isSignedIn() && currentUserEmail() == email.lower() &&
                    request.resource.data.role == resource.data.role &&
                    request.resource.data.email == resource.data.email;
    }

    // ==========================================
    // 2. Bookings Rules (Calendar slots & projects)
    // ==========================================
    match /bookings/{bookingId} {
      // Read: Only signed-in users can view bookings (protects personal data)
      allow read: if isSignedIn();
      
      // Create: Authenticated users (church leaders and admins) can book a slot
      allow create: if isSignedIn();
      
      // Update/Delete: Only the original creator of the booking, their Church Leader, or an Admin can modify it
      allow update, delete: if isAdmin() || (isSignedIn() && (
                              request.auth.token.email.lower() == resource.data.requesterEmail.lower() ||
                              isChurchLeaderFor(resource.data.churchName)
                            ));
    }

    // ==========================================
    // 3. Settings Rules (System limits & scoring parameters)
    // ==========================================
    match /settings/{settingId} {
      // Public Read: App settings (time slots, date ranges, grading fields) are read on startup
      allow read: if true;
      
      // Write: Only Admins can modify settings
      allow write: if isAdmin();
    }

    // ==========================================
    // 4. Evaluations Rules (Servant grading & feedback)
    // ==========================================
    match /evaluations/{evaluationId} {
      // Admins and Servants can read grading reviews
      allow read: if isAdmin() || isServant();
      
      // Create/Update: Servants can grade teams and update their own grades (Id format: bookingId_email)
      allow create, update: if isServant() && 
                            request.resource.data.servantEmail == currentUserEmail() &&
                            evaluationId == request.resource.data.bookingId + '_' + currentUserEmail();
      
      // Admins have full access to manage evaluations
      allow write: if isAdmin();
    }

    // ==========================================
    // 5. Access Requests Rules (New user onboarding)
    // ==========================================
    match /access_requests/{requestId} {
      // Admins can read, update, delete requests
      allow read, update, delete: if isAdmin();
      
      // Signed-in users can create an access request
      allow create: if isSignedIn();
      
      // Users can read their own requests
      allow read: if isSignedIn() && resource.data.email.lower() == currentUserEmail();
    }

    // ==========================================
    // 6. Notifications Rules (In-app alerts)
    // ==========================================
    match /notifications/{notificationId} {
      // Users can read and update (mark as read) their own notifications
      allow read, update: if isSignedIn() && resource.data.userId == currentUserEmail();
      
      // Admins can create notifications for users
      allow create: if isAdmin();
    }
  }
}
